# Copy this file to `.env` and fill in your key. `.env` is gitignored.
# Get a free Groq API key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here

# Optional: where local data (chats, settings, knowledge base) is stored.
# URDP_DATA_DIR=./data

# Optional model overrides (defaults shown below):
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_DETECT_MODEL=openai/gpt-oss-20b
