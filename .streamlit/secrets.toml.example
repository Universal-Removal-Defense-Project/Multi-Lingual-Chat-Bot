# Copy this file to `secrets.toml` (same folder) and fill in your key.
# `secrets.toml` is gitignored — never commit your real key.
# Get a free Groq API key at https://console.groq.com/keys

GROQ_API_KEY = "gsk_your_key_here"

# Note: GROQ_MODEL / GROQ_DETECT_MODEL overrides are NOT read from this file —
# backend.py only checks the environment (os.environ), not st.secrets. Set them
# in `.env` or your shell instead; see .env.example. Current defaults:
#   GROQ_MODEL        = openai/gpt-oss-120b
#   GROQ_DETECT_MODEL = groq/compound-mini
